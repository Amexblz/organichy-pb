# Database connection (SQLite default for zero-friction local run, or PostgreSQL: postgresql://user:password@localhost:5432/organichydb)
DATABASE_URL="file:./dev.db"

# JWT Secret for Auth sessions
JWT_SECRET="organichy-jwt-secret-key-replace-in-production"

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Razorpay Configuration
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_TqvEEanuQFa49Y"
RAZORPAY_KEY_SECRET="your_razorpay_secret_here"

# Initial Admin Credentials (used during seed)
ADMIN_INIT_EMAIL="admin@organichy.com"
ADMIN_INIT_PASSWORD="AdminPassword@123"

# Node environment
NODE_ENV="development"
